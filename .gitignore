# ============================================
# Project Specific
# ============================================

# Cryptographic keys and certificates (NEVER commit these!)
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
*.jks
*.keystore
*.priv
*.pub
keys/
certs/
secrets/

# Configuration files with sensitive data
*.secret
*.credentials
config.local.yaml
.env.local
.env.*.local

# QKD simulation data
qkd_keys/
quantum_states/
*.qasm
*.qpy

# Test results and benchmarks
test_results/
benchmark_results/
*.benchmark
*.prof
*.lprof

# Logs
logs/
*.log
*.log.*

# Hardware-in-Loop specific
hil_data/
can_traces/
*.blf
*.asc
*.trc

# AUTOSAR artifacts
*.arxml.bak
autosar_output/

# OTA firmware images (these are typically large)
firmware/
*.bin
*.hex
*.elf
ota_packages/

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.bak
*.swp

# Database files
*.db
*.sqlite
*.sqlite3

# Documentation builds
_build/
_static/
_templates/

# Compliance reports
compliance_reports/
audit_logs/

# ============================================
# Security & Compliance
# ============================================

# Never commit these patterns
*password*
*secret*
*token*
*api_key*
*private_key*

# Exception: Documentation and example files are OK
!docs/*password*.md
!examples/*secret*.example
!examples/*key*.example

# ============================================
# CI/CD
# ============================================

.gitlab-ci-local/
.github/workflows/*.log

